\frametitle{Premiers éléments de réponse : presque prêts en 2030, pas en 2040}
\begin{columns}[c,onlytextwidth]
    \begin{column}{0.52\textwidth}
      \centering
      {\small\bfseries\color{primary}Réseaux de niveau 7 en dépassement\par
       \footnotesize\color{subtle}par type de contrainte\par}
      \vspace{0.6em}
      \shorthandoff{;:!?}% pgfplots lit le ; final avant que babel le rende
      \begin{tikzpicture}
        \begin{axis}[
            xbar, scale only axis, width=2.9cm, height=2.8cm,
            bar width=6pt, enlarge y limits=0.18,
            xmin=0, xmax=300, clip=false, hide x axis,
            axis y line*=left, y axis line style={draw=subtle},
            ytick=data, symbolic y coords={volt,trafo,line},
            yticklabels={Tension au-delà de EN~50160, Transformateur surchargé,
                         Ligne surchargée},
            yticklabel style={font=\footnotesize, text=ink},
            major tick length=0pt,
            nodes near coords={\pgfmathprintnumber[assume math mode=true]{\pgfplotspointmeta}},
            nodes near coords style={font=\scriptsize, text=ink},
            area legend, reverse legend,
            legend style={draw=none, font=\footnotesize, text=ink,
                          at={(1,1.03)}, anchor=south east, legend columns=2,
                          /tikz/every even column/.append style={column sep=8pt}},
          ]
          % tension : réseaux hors de la bande 0,9--1,1 pu (EN 50160), sous- ou
          % surtension ; 2040 : 216 sous-tension + 30 surtension, 29 les deux = 217 ;
          % 2030 : 30 sous-tension, aucune surtension.
          \addplot[fill=primary, draw=none]
            coordinates {(217,volt) (241,trafo) (270,line)};
          \addplot[fill=primary!40, draw=none]
            coordinates {(30,volt) (3,trafo) (28,line)};
          \legend{2040, 2030}
        \end{axis}
      \end{tikzpicture}
    \end{column}
    \begin{column}{0.44\textwidth}
      \kpi[2.2cm]{4\,\%}{des réseaux de\\niveau 7 en 2030\\(45 sur 1036)}\hfill
      \kpi[2.2cm]{36\,\%}{des réseaux de\\niveau 7 en 2040\\(371 sur 1036)}


