# Normalise line endings to LF in the repository and in checkouts
# (the whole tree was once flipped to CRLF by an editor; this stops a repeat).
*       text=auto eol=lf
*.m     text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf

*.mat   binary
*.pdf   binary
*.png   binary
